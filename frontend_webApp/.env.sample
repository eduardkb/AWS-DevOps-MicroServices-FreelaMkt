# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-key

# Backend API
API_URL=https://your-api-base-url.example.com/api

# AWS Cognito — OAuth 2.0 / PKCE (public client — no client_secret needed)
# Your User Pool domain (without https://)
# e.g. us-east-1xxxxxxxxc.auth.us-east-1.amazoncognito.com
# Found at: Cognito -> Branding -> Domain -> Domain
COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com

# App Client ID from your User Pool App Client
# Make sure the App Client has "Authorization code grant" enabled,
# NO client secret (public client), and PKCE required.
# Found at: Cognito -> App Clients -> Client ID
COGNITO_CLIENT_ID=1a2b3c4d5e6f7g8h9i0jKLMNOP

# The URL Cognito redirects to after login (must match App Client Allowed Callback URLs)
COGNITO_REDIRECT_URI=http://localhost:80/auth/callback

# The URL Cognito redirects to after logout (must match App Client Allowed Sign-out URLs)
COGNITO_LOGOUT_URI=http://localhost:80
